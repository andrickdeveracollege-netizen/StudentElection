FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY StudentElection/StudentElection.csproj StudentElection/
RUN dotnet restore StudentElection/StudentElection.csproj
COPY StudentElection/ StudentElection/
RUN dotnet publish StudentElection/StudentElection.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app
ENV ASPNETCORE_HTTP_PORTS=80
EXPOSE 80
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "StudentElection.dll"]
